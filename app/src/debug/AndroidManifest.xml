<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: fake alerts for device tests (DebugAlertReceiver). exported: adb's `am broadcast` needs it;
     DUMP (held by adb shell, not by apps) keeps other apps from firing it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.nemuigames.nemuitv.alerts.DebugAlertReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.nemuigames.nemuitv.DEBUG_ALERT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
